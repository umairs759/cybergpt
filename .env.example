# Cybersecurity Mentor Chatbot - Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini  # or gpt-3.5-turbo

# NVIDIA NIM Configuration
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEYS=your_nvidia_api_key_1,your_nvidia_api_key_2
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_FAILOVER_MODEL=deepseek-ai/deepseek-v4.1-flash

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=cyber_mentor_secret_key_change_me

# Rate Limiting
RATELIMIT_DEFAULT=200 per day; 50 per hour
RATELIMIT_STORAGE_URL=memory://

# Server Configuration
HOST=127.0.0.1
PORT=5000
