# =====================================================================
# CyberGPT — Environment Configuration (TEMPLATE ONLY)
# ---------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — NEVER commit real keys to this repository.
# Zero hardcoded keys: the application reads everything from the
# environment at runtime (Security Pillar 3).
# =====================================================================

# --- NVIDIA NIM (primary inference provider) -------------------------
# Comma-separated pool of your own nvapi- keys (rotated automatically;
# 401/403 keys are quarantined at runtime).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEYS=nvapi-your_first_key_here,nvapi-your_second_key_here
NVIDIA_API_KEY=nvapi-your_single_key_here

# --- Bring-Your-Own-Key (BYOK) — OPTIONAL ----------------------------
# Users may instead store personal OpenAI / Anthropic keys in the
# browser Settings modal (localStorage, sent per-request only).
# These server-side entries are an alternative for headless usage.
OPENAI_API_KEY=sk-your_openai_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Application Settings ---------------------------------------------
# FLASK_DEBUG must remain "0" outside local development (Pillar 5).
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=change_me_to_a_long_random_string

# --- Rate Limiting (Pillar 1) ------------------------------------------
RATELIMIT_DEFAULT=35 per minute
RATELIMIT_STORAGE_URL=memory://

# --- Server Configuration (strictly local) -----------------------------
HOST=127.0.0.1
PORT=5000
